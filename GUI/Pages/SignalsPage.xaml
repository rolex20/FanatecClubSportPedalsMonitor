<Page
    x:Class="PedDash.Pages.SignalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PedDash.Controls"
    xmlns:models="using:PedDash.Models"
    Background="Transparent">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <!-- Left side for charts -->
            <ColumnDefinition Width="3*" /> 
            <ColumnDefinition Width="20" />
            <!-- Right side for events list -->
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
            <Border Background="#161620" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel Spacing="10">
                    <!-- Header with Toggle -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="WAVEFORMS" Foreground="#bbb" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="Export Events CSV" Click="ExportEvents_Click" Background="#222" Foreground="#fff" BorderBrush="#555" Padding="10,4" />
                            <Button Content="Export Telemetry CSV" Click="ExportTelemetry_Click" Background="#222" Foreground="#fff" BorderBrush="#555" Padding="10,4" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock Text="Height" Foreground="#777" VerticalAlignment="Center" FontSize="12" />
                            <Button x:Name="BtnWaveHeightDown" Content="-" Click="BtnWaveHeightDown_Click" Background="#222" Foreground="#fff" BorderBrush="#555" Padding="8,1" MinWidth="30" />
                            <TextBlock x:Name="TxtWaveHeight" Text="100%" Foreground="#bbb" FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Center" MinWidth="42" />
                            <Button x:Name="BtnWaveHeightUp" Content="+" Click="BtnWaveHeightUp_Click" Background="#222" Foreground="#fff" BorderBrush="#555" Padding="8,1" MinWidth="30" />
                            <TextBlock Text="Hide Brake" Foreground="#777" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" />
                            <ToggleSwitch x:Name="TglHideBrake" IsOn="False" Toggled="TglHideBrake_Toggled" MinWidth="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="GAS INPUT HISTORY" Foreground="#00ff66" FontFamily="Consolas" />
                    <local:Win2DChartControl x:Name="ChartGas" Height="220" LineColor="#00ff66" FillArea="True" MaxValue="100" />
                    
                    <TextBlock x:Name="TxtBrakeTitle" Text="BRAKE INPUT HISTORY" Foreground="#ff3333" FontFamily="Consolas" Margin="0,15,0,0"/>
                    <local:Win2DChartControl x:Name="ChartBrake" Height="220" LineColor="#ff3333" FillArea="True" MaxValue="100" />
                
                    <TextBlock Text="CLUTCH INPUT HISTORY" Foreground="#00f3ff" FontFamily="Consolas" Margin="0,15,0,0"/>
                    <local:Win2DChartControl x:Name="ChartClutch" Height="220" LineColor="#00f3ff" FillArea="True" MaxValue="100" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Column="2" Background="#161620" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,0,1" Background="#1a1a24" Padding="15,10" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Time" Foreground="#00f3ff" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="Type" Foreground="#00f3ff" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="Details" Foreground="#00f3ff" FontWeight="Bold" />
                    </Grid>
                </Border>
                
                <!-- List -->
                <ListView x:Name="LvEvents" Grid.Row="1" Background="Transparent" SelectionMode="None" >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
